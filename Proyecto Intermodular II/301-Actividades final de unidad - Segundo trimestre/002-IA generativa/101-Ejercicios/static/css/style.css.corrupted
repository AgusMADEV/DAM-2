/* ========================================
   INMOWEB AI - ESTILOS PERSONALIZADOS
   Generador de sitios inmobiliarios
======================================== */

*,
*::before,
*::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

:root {
    /* Colores corporativos inmobiliaria - Paleta premium */
    --primary-blue: #0a1929;
    --primary-blue-light: #1e3a5f;
    --primary-blue-dark: #020817;
    --accent-gold: #c9a961;
    --accent-gold-light: #d4b982;
    --accent-gold-dark: #a68b4d;
    
    /* Escala de grises refinada */
    --white: #ffffff;
    --gray-50: #fafbfc;
    --gray-100: #f3f5f7;
    --gray-200: #e8eaed;
    --gray-300: #d1d5db;
    --gray-400: #9ca3af;
    --gray-500: #6b7280;
    --gray-600: #4b5563;
    --gray-700: #374151;
    --gray-800: #1f2937;
    --gray-900: #0f1419;
    
    /* Estados */
    --success: #059669;
    --error: #dc2626;
    --warning: #d97706;
    --info: #2563eb;
    
    /* Sombras elegantes con profundidad */
    --shadow-sm: 0 1px 2px 0 rgba(0, 0, 0, 0.06);
    --shadow-md: 0 4px 8px -2px rgba(0, 0, 0, 0.12), 0 2px 4px -2px rgba(0, 0, 0, 0.08);
    --shadow-lg: 0 12px 24px -4px rgba(0, 0, 0, 0.12), 0 8px 16px -4px rgba(0, 0, 0, 0.08);
    --shadow-xl: 0 20px 40px -8px rgba(0, 0, 0, 0.15), 0 12px 24px -8px rgba(0, 0, 0, 0.1);
    --shadow-2xl: 0 32px 64px -12px rgba(0, 0, 0, 0.2), 0 20px 48px -12px rgba(0, 0, 0, 0.15);
    --shadow-gold: 0 8px 24px -4px rgba(201, 169, 97, 0.25);
    --shadow-inset: inset 0 2px 4px 0 rgba(0, 0, 0, 0.06);
    
    /* Tipografía */
    --font-display: 'Playfair Display', Georgia, serif;
    --font-body: 'Inter', system-ui, sans-serif;
    
    /* Transiciones suaves */
    --transition-fast: 150ms cubic-bezier(0.4, 0, 0.2, 1);
    --transition-base: 250ms cubic-bezier(0.4, 0, 0.2, 1);
    --transition-slow: 350ms cubic-bezier(0.4, 0, 0.2, 1);
    --transition-bounce: 500ms cubic-bezier(0.68, -0.55, 0.265, 1.55);
    
    /* Degradados premium */
    --gradient-gold: linear-gradient(135deg, #c9a961 0%, #d4b982 50%, #c9a961 100%);
    --gradient-blue: linear-gradient(180deg, #0a1929 0%, #1e3a5f 100%);
    --gradient-glass: linear-gradient(135deg, rgba(255, 255, 255, 0.1) 0%, rgba(255, 255, 255, 0.05) 100%);
}

body {
    font-family: var(--font-body);
    background: linear-gradient(to bottom right, #fafbfc 0%, #f3f5f7 50%, #e8eaed 100%);
    background-attachment: fixed;
    color: var(--gray-900);
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
}

body::before {
    content: '';
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-image: 
        radial-gradient(circle at 20% 50%, rgba(201, 169, 97, 0.08) 0%, transparent 50%),
        radial-gradient(circle at 80% 80%, rgba(10, 25, 41, 0.05) 0%, transparent 50%);
    pointer-events: none;
    z-index: 0;
}

/* ========================================
   LAYOUT PRINCIPAL
======================================== */

.app-container {
    display: flex;
    min-height: 100vh;
    position: relative;
    z-index: 1;
}

/* ========================================
   SIDEBAR
======================================== */

.sidebar {var(--gradient-blue);
    color: var(--white);
    display: flex;
    flex-direction: column;
    position: fixed;
    height: 100vh;
    overflow-y: auto;
    z-index: 100;
    box-shadow: var(--shadow-2xl);
    border-right: 1px solid rgba(201, 169, 97, 0.2);
}

.sidebar::before {
    content: '';
    position: relative;
}

.logo-icon {
    font-size: 3rem;
    margin-bottom: 0.5rem;
    display: block;
    filter: drop-shadow(0 4px 8px rgba(201, 169, 97, 0.3));
    animation: float 3s ease-in-out infinite;
}

@keyframes float {
    0%, 100% { transform: translateY(0px); }
    50% { transform: translateY(-10px); }
}

.logo h1 {
    font-family: var(--font-display);
    font-size: 1.875rem;
    font-weight: 700;
    margin-bottom: 0.25rem;
    color: var(--white);
    letter-spacing: -0.02em;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
}5);
    line-height: 1.5;
    font-weight: 300;
    letter-spacing: 0.01em
.logo h1 span {
    background: var(--gradient-gold);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text
    margin-bottom: 0.5rem;
    display: block;
}

.logo h1 {
    font-family: var(--font-display);
    font-si875rem;
    padding: 1rem 1.5rem;
    background: none;
    border: none;
    color: rgba(255, 255, 255, 0.75);
    font-family: var(--font-body);
    font-size: 0.9375rem;
    font-weight: 500;
    cursor: pointer;
    transition: all var(--transition-base);
    position: relative;
    letter-spacing: 0.01em;
}

.nav-item::before {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%) scaleY(0);
    height: 60%;
    width: 4px;
    background: var(--gradient-gold);
    border-radius: 0 4px 4px 0;
    transition: transform var(--transition-base);
    box-shadow: var(--shadow-gold);
}

.nav-item::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--gradient-glass);
    opacity: 0;
    transition: opacity var(--transition-base);
    border-radius: 0.5rem;
    margin: 0.25rem 0.5rem;
}

.nav-item:hover {
    color: var(--white);
    transform: translateX(4px);
}

.nav-item:hover::after {
    opacity: 1;gradient-gold);
    color: var(--primary-blue-dark);
    padding: 0.25rem 0.625rem;
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 700;
    box-shadow: var(--shadow-gold);
    border: 1px solid rgba(255, 255, 255, 0.2);
    letter-spacing: 0.02em(201, 169, 97, 0.1);
}

.nav-item.active::before {
    transform: translateY(-50%) scaleY(1);
}

.nav-item.active::after {
    opacity: 1--transition-base);
    position: relative;
}

.nav-item::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 4px;
    background: var(--accent-gold);
    transform: scaleY(0);
    transition: transform var(--transition-base);
}

.nav-item:hover {
    background: rgba(255, 255, 255, 0.1);
    color: var(--white);
}

.nav-item.active {
    background: rgba(255, 255, 255, 0.15);
    color: var(--white);
}

.nav-item.active::before {
    transform: scaleY(1);
}

.nav-icon {625rem;
    font-weight: 700;
    background: var(--gradient-gold);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    text-shadow: 0 0 20px rgba(201, 169, 97, 0.3

.badge {
    margin-left: auto;
    background: var(--accent-gold);
    color: var(--primary-blue-dark);
    padding: 0.125rem 0.5rem;
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 600;
}

/* Footer del sidebar */

.sidebar-footer {
    padding: 1.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
}

.stats {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
}

.stat-item {
    text-align: center;
}

.stat-label {
    display: block;
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.6);
    margin-bottom: 0.25rem;
}

.stat-value {
    display: block;
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--accent-gold);
}

/* ========================================
   CONTENIDO PRINCIPAL
======================================== */

.main-content {
    margin-left: 280px;
    flex: 1;
    padding: 2rem;
    min-height: 100vh;
}

.view {
    display: none;
}

.view.active {
    display: block;
}

.view-header {
    margin-bottom: 2rem;
}

.view-header h2 {
    font-family: var(--font-display);
    font-size: 2.25rem;
    color: var(--primary-blue);
    margin-bottom: 0.75rem;
    letter-spacing: -0.02em;
    font-weight: 700;
}

.view-header p {
    color: var(--gray-600);
    font-size: 1.0625rem;
    font-weight: 400;
    letter-spacing: 0.01em;
}

/* ========================================
   GRID DE CONTENIDO
======================================== */

.content-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    align-items: start;
}

.column-left,
.column-right {
    min-height: 400px;
}

/* ========================================
   FORMULARIO GENERADOR
======================================== */

.generator-form {
    background: var(--white);
    padding: 2.5rem;
    border-radius: 1.25rem;
    box-shadow: var(--shadow-xl);
    border: 1px solid var(--gray-200);
    backdrop-filter: blur(10px);
    position: relative;
    overflow: hidden;
}

.generator-form::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    background: var(--gradient-gold);
}

.form-section {
    margin-bottom: 1.5rem;
}

.form-label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 600;
    color: var(--gray-700);
    margin-bottom: 0.5rem;
    font-size: 0.9375rem;
}

.label-icon {
    font-size: 1.125rem;
}

.form-textarea,
.form-input,
.form-select {
    width: 100%;
    padding: 0.75rem 1rem;
    border: 2px solid var(--gray-200);
    border-radius: 0.5rem;
    font-family: var(--font-body);
    font-size: 0.9375rem;
    transition: all var(--transition-base);
    background: var(--white);
}

.form-textarea {
    resize: vertical;
    min-height: 100px;
}

.form-textarea:focus,
.form-input:focus,
.form-select:focus {
    outline: none;
    border-color: var(--primary-blue);
    box-shadow: 0 0 0 3px rgba(0, 61, 130, 0.1);
}

.form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-bottom: 1.5rem;
}

.form-group {
    margin-bottom: 1.5rem;
}

/* Botón generar */

.btn-generate {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    padding: 1.125rem 2rem;
    background: var(--gradient-gold);
    color: var(--primary-blue-dark);
    border: none;
    border-radius: 0.875rem;
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: 700;
    cursor: pointer;
    transition: all var(--transition-base);
    box-shadow: var(--shadow-gold), 0 4px 12px rgba(201, 169, 97, 0.3);
    position: relative;
    overflow: hidden;
    letter-spacing: 0.02em;
}

.btn-generate::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.2) 0%, transparent 100%);
    opacity: 0;
    transition: opacity var(--transition-base);
}

.btn-generate:hover:not(:disabled) {
    transform: translateY(-3px);
    box-shadow: var(--shadow-gold), 0 8px 24px rgba(201, 169, 97, 0.4);
}

.btn-generate:hover:not(:disabled)::before {
    opacity: 1;
}

.btn-generate:active:not(:disabled) {
    transform: translateY(-1px);
}

.btn-generate:disabled {
    opacity: 0.6;
    cursor: not-allowed;
    transform: none;
}

.btn-icon {
    font-size: 1.25rem;
}

/* Mensaje de estado */

.status-message {
    margin-top: 1rem;
    padding: 0.75rem 1rem;
    border-radius: 0.5rem;
    font-size: 0.9375rem;
    display: none;
}

.status-message.show {
    display: block;
}

.status-message.success {
    background: #d1fae5;
    color: #065f46;
    border-left: 4px solid var(--success);
}

.status-message.error {
    background: #fee2e2;
    color: #991b1b;
    border-left: 4px solid var(--error);
}

.status-message.loading {
    background: #dbeafe;
    color: #1e40af;
    border-left: 4px solid var(--info);
}

/* Acciones del formulario */

.form-actions {
    display: flex;
    gap: 0.75rem;
    margin-top: 1.5rem;
}

.btn-secondary {
    flex: 1;
    padding: 0.875rem 1.25rem;
    background: var(--gray-50);
    color: var(--gray-700);
    border: 2px solid var(--gray-200);
    border-radius: 0.75rem;
    font-family: var(--font-body);
    font-size: 0.875rem;
    font-weight: 600;
    cursor: pointer;
    transition: all var(--transition-base);
    box-shadow: var(--shadow-sm);
}

.btn-secondary:hover {
    background: var(--white);
    border-color: var(--accent-gold);
    color: var(--gray-900);
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
}

/* ========================================
   PLANTILLAS RÁPIDAS
=============2rem;
    border-radius: 1.25rem;
    box-shadow: var(--shadow-lg);
    border: 1px solid var(--gray-200);
}

.quick-templates h3 {
    font-size: 1.125rem;
    color: var(--gray-800);
    margin-bottom: 1.25rem;
    font-weight: 700;
    letter-spacing: -0.01

.quick-templates h3 {
    font-size: 1.125rem;
    color: var(--gray-800);
    margin-bottom: 1rem;
}

.template-grid {
    display: grid;
    grid-te625rem;
    padding: 1.25rem;
    background: var(--gray-50);
    border: 2px solid var(--gray-200);
    border-radius: 1rem;
    cursor: pointer;
    transition: all var(--transition-base);
    position: relative;
    overflow: hidden;
}

.template-card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--gradient-glass);
    opacity: 0;
    transition: opacity var(--transition-base);
}

.template-card:hover {
    border-color: var(--accent-gold);
    background: var(--white);
    transform: translateY(-4px) scale(1.02);
    box-shadow: var(--shadow-lg);
}

.template-card:hover::before {
    opacity: 1;
}

.template-icon {
    font-size: 2.25rem;
    filter: drop-sha.25rem;
    box-shadow: var(--shadow-xl);
    overflow: hidden;
    position: sticky;
    top: 2rem;
    border: 1px solid var(--gray-200);
}

.preview-header {
    padding: 1.5rem 1.75rem;
    background: linear-gradient(to bottom, var(--gray-50), var(--white));
    border-bottom: 2px solid var(--gray-200);
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.preview-header h3 {
    font-size: 1.125rem;
    color: var(--gray-800);
    font-weight: 700;
    letter-spacing: -0.01em
}

.template-name {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(625rem 0.875rem;
    background: var(--white);
    border: 2px solid var(--gray-200);
    border-radius: 0.625rem;
    font-size: 1.25rem;
    cursor: pointer;
    transition: all var(--transition-base);
    box-shadow: var(--shadow-sm);
}

.device-btn:hover {
    border-color: var(--accent-gold);
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
}

.device-btn.active {
    background: var(--gradient-gold);
    border-color: var(--accent-gold-dark);
    box-shadow: var(--shadow-gold);
    transform: scale(1.05
.preview-header {
    padding: 1.25rem 1.5rem;
    background: var(--gray-50);
    border-bottom: 1px solid var(--gray-200);
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.preview-header h3 {
    font-size: 1.125rem;
    color: var(--gray-800);
}

.preview-controls {
    display: flex;
    gap: 0.5rem;
}

.device-btn {
    padding: 0.5rem 0.75rem;
    background: var(--white);
    border: 2px solid var(--gray-200);
    border-radius: 0.5rem;
    font-size: 1.25rem;
    cursor: pointer;
    transition: all var(--transition-base);
}

.device-btn:hover {
    border-color: var(--primary-blue);
}

.device-btn.active {
    background: var(--primary-blue);
    border-color: var(--primary-blue);
    filter: grayscale(1) brightness(2);
}

.iframe-wrapper {
    width: 100%;
    height: 600px;
    background: var(--gray-100);
    transition: all var(--transition-base);
}

.iframe-wrapper.desktop {
    height: 600px;
}

.iframe-wrapper.tablet {
    width: 768px;
    height: 600px;
    margin: 0 auto;
}

.iframe-wrapper.mobile {
    width: 375px;
    height: 600px;
    margin: 0 auto;
}

.iframe-wrapper iframe {
    width: 100%;
    height: 100%;
    border: none;
}

/* ========================================
   PROYECTOS
======================================== */

.proyectos-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1.5rem;
}

.proyecto-card {
    background: var(--white);
    border-radius: 1rem;
    overflow: hidden;
    box-shadow: var(--shadow-md);
    transition: all var(--transition-base);
}

.proyecto-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-xl);
}

.proyecto-preview {
    height: 200px;
    background: var(--gray-100);
    position: relative;
    overflow: hidden;
}

.proyecto-preview iframe {
    width: 100%;
    height: 100%;
    border: none;
    pointer-events: none;
    transform: scale(0.5);
    transform-origin: top left;
}

.proyecto-info {
    padding: 1.5rem;
}

.proyecto-title {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--gray-900);
    margin-bottom: 0.5rem;
}

.proyecto-meta {
    display: flex;
    gap: 1rem;
    margin-bottom: 1rem;
    font-size: 0.875rem;
    color: var(--gray-600);
}

.proyecto-actions {
    display: flex;
    gap: 0.5rem;
}

.btn-icon-only {
    padding: 0.5rem;
    background: var(--gray-100);
    border: 1px solid var(--gray-300);
    border-radius: 0.5rem;
    cursor: pointer;
    transition: all var(--transition-base);
}

.btn-icon-only:hover {
    background: var(--gray-200);
}

/* ========================================
   PLANTILLAS
======================================== */

.plantillas-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 2rem;
}

.plantilla-card {
    background: var(--white);
    border-radius: 1rem;
    overflow: hidden;
    box-shadow: var(--shadow-md);
    transition: all var(--transition-base);
}

.plantilla-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-xl);
}

.plantilla-preview {
    height: 200px;
    background: linear-gradient(135deg, var(--primary-blue) 0%, var(--primary-blue-light) 100%);
    display: flex;
    align-items: center;
    justify-content: center;
}

.preview-placeholder {
    font-size: 4rem;
}

.plantilla-card h3 {
    padding: 1rem 1.5rem 0.5rem;
    font-size: 1.25rem;
    color: var(--gray-900);
}

.plantilla-card p {
    padding: 0 1.5rem 1rem;
    font-size: 0.9375rem;
    color: var(--gray-600);
    line-height: 1.5;
}

.btn-use-template {
    width: 100%;
    padding: 0.875rem;
    background: var(--primary-blue);
    color: var(--white);
    border: none;
    font-family: var(--font-body);
    font-size: 0.9375rem;
    font-weight: 600;
    cursor: pointer;
    transition: all var(--transition-base);
}

.btn-use-template:hover {
    background: var(--primary-blue-light);
}

/* ========================================
   MODAL
======================================== */

.modal {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, 0.5);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 1000;
    backdrop-filter: blur(4px);
}

.modal[hidden] {
    display: none;
}

.modal-content {
    background: var(--white);
    border-radius: 1rem;
    max-width: 500px;
    width: 90%;
    box-shadow: var(--shadow-2xl);
    animation: modalSlideIn 0.3s ease;
}

@keyframes modalSlideIn {
    from {
        opacity: 0;
        transform: translateY(-20px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

.modal-header {
    padding: 1.5rem;
    border-bottom: 1px solid var(--gray-200);
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.modal-header h3 {
    font-size: 1.25rem;
    color: var(--gray-900);
}

.modal-close {
    background: none;
    border: none;
    font-size: 1.5rem;
    color: var(--gray-400);
    cursor: pointer;
    transition: color var(--transition-base);
}

.modal-close:hover {
    color: var(--gray-600);
}

.modal-body {
    padding: 1.5rem;
}

.modal-footer {
    padding: 1.5rem;
    border-top: 1px solid var(--gray-200);
    display: flex;
    justify-content: flex-end;
    gap: 0.75rem;
}

.btn-primary {
    padding: 0.75rem 1.5rem;
    background: var(--primary-blue);
    color: var(--white);
    border: none;
    border-radius: 0.5rem;
    font-family: var(--font-body);
    font-size: 0.9375rem;
    font-weight: 600;
    cursor: pointer;
    transition: all var(--transition-base);
}

.btn-primary:hover {
    background: var(--primary-blue-light);
}

/* ========================================
   RESPONSIVE
======================================== */

@media (max-width: 1200px) {
    .content-grid {
        grid-template-columns: 1fr;
    }
    
    .preview-container {
        position: static;
    }
}

@media (max-width: 768px) {
    .sidebar {
        width: 240px;
    }
    
    .main-content {
        margin-left: 240px;
        padding: 1.5rem;
    }
    
    .form-row {
        grid-template-columns: 1fr;
    }
    
    .template-grid {
        grid-template-columns: 1fr;
    }
}

@media (max-width: 640px) {
    .sidebar {
        transform: translateX(-100%);
        transition: transform var(--transition-base);
    }
    
    .sidebar.open {
        transform: translateX(0);
    }
    
    .main-content {
        margin-left: 0;
    }
}
